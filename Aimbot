-- ===== ОПРЕДЕЛЕНИЕ КОМАНД =====
local function getTeam(player)
    if not player or not player.Character then return nil end
    local name = player.Name:lower()
    if name:find("sheriff") or name:find("шериф") then return "Sheriff"
    elseif name:find("murderer") or name:find("убийц") or name:find("kill") then return "Murderer"
    end
    if player.Team then return player.Team.Name end
    local myTeam = plr.Team
    if myTeam and player.Team == myTeam then return "Ally"
    else return "Enemy" end
end

local function isEnemy(player)
    if player == plr then return false end
    local myTeam = getTeam(plr)
    local theirTeam = getTeam(player)
    if myTeam == "Ally" or theirTeam == "Ally" then
        return myTeam ~= theirTeam
    end
    return theirTeam ~= myTeam
end

-- ===== WALLHACK (для прицела) =====
local function canSee(pos1, pos2)
    local ray = Ray.new(pos1, pos2 - pos1)
    local part, hit = ws:FindPartOnRayWithIgnoreList(ray, {plr.Character})
    return (hit - pos1).Magnitude >= (pos2 - pos1).Magnitude - 2
end

-- ===== СОЗДАНИЕ КНОПОК (элегантные) =====
local function makeToggle(name, y, def, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 170, 0, 26)
    b.Position = UDim2.new(0, 10, 0, y)
    b.BackgroundColor3 = def and Color3.new(0.3, 0, 0) or Color3.new(0.1, 0.1, 0.1)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Text = name .. "  " .. (def and "●" or "○")
    b.Font = Enum.Font.SourceSansBold
    b.TextSize = 13
    b.BorderSizePixel = 0
    b.TextXAlignment = Enum.TextXAlignment.Left
    b.Parent = menu

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = b

    b.MouseButton1Click:Connect(function()
        def = not def
        b.BackgroundColor3 = def and Color3.new(0.3, 0, 0) or Color3.new(0.1, 0.1, 0.1)
        b.Text = name .. "  " .. (def and "●" or "○")
        if callback then callback(def) end
    end)
    return b
end

