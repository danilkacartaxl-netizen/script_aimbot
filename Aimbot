local function createColorButton(xPos, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 30, 0, 30)
    btn.Position = UDim2.new(0, xPos, 0.5, -15)
    btn.BackgroundColor3 = color
    btn.Text = ""
    btn.BorderSizePixel = 0
    btn.Parent = skinCard
    
    local bCorner = Instance.new("UICorner")
    bCorner.CornerRadius = UDim.new(0, 6)
    bCorner.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        Settings.AccentColor = color
        MainStroke.Color = color
        Line.BackgroundColor3 = color
        TitleAccent.TextColor3 = color
        
        -- Обновляем все тумблеры и слайдеры
        for _, t in ipairs(MainFrame:GetDescendants()) do
            if t:IsA("TextButton") and t.BackgroundColor3 ~= Color3.fromRGB(50, 50, 50) and t.Size.X.Offset == 30 then
                if Settings[t.Name] then
                    t.BackgroundColor3 = color
                end
            end
            if t:IsA("Frame") and t.Size.Y.Offset == 2 and t.Parent:FindFirstChild("Frame") then
                t.Frame.BackgroundColor3 = color
            end
        end
    end)
    return btn
end

