-- ИГРОВАЯ ЛОГИКА
-- ==============================================
local function isEnemy(target)
    if target == plr then return false end
    if Settings.TeamCheck and target.Team and plr.Team then
        return target.Team.Name ~= plr.Team.Name
    end
    return true
end

local function canSee(pos1, pos2)
    local ray = Ray.new(pos1, pos2 - pos1)
    local hit = ws:FindPartOnRayWithIgnoreList(ray, {plr.Character})
    return hit == nil
end

-- Aimbot
rs.RenderStepped:Connect(function()
    if not Settings.Aimbot then return end
    
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local bestDist = Settings.FOV
    local target = nil
    
    for _, p in ipairs(players:GetPlayers()) do
        if p ~= plr and isEnemy(p) and p.Character then
            local head = p.Character:FindFirstChild("Head")
            if head then
                local pos, onScreen = cam:WorldToViewportPoint(head.Position)
                if onScreen and pos.Z > 0 then
                    local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        target = head.Position
                    end
                end
            end
        end
    end
    
    if target then
        local cf = CFrame.lookAt(cam.CFrame.Position, target)
        cam.CFrame = cam.CFrame:Lerp(cf, Settings.Smooth)
    end
end)

-- ESP (Boxes 2D с очертаниями, трассеры, Wallhack)
rs.RenderStepped:Connect(function()
    if not Settings.ESP then
        for _, data in pairs(espObjects) do
            if data then data:Destroy() end
        end
        espObjects = {}
        return
    end
    
    for _, p in ipairs(players:GetPlayers()) do
        if p == plr or not p.Character then continue end
        
        local char = p.Character
        local enemy = isEnemy(p)
        local color = enemy and COLORS.Enemy or COLORS.Ally
        
        if not espObjects[p] then
            local folder = Instance.new("Folder")
            folder.Name = "ESP_" .. p.Name
            folder.Parent = char
            
            -- Box 2D с очертаниями (красивый)
            if Settings.ShowBoxes then
                local box = Instance.new("BoxHandleAdornment")
                box.Size = Vector3.new(3.2, 5.2, 1.2)
                box.Adornee = char
                box.Color3 = color
                box.Transparency = 0.15
                box.AlwaysOnTop = Settings.Wallhack
                box.Parent = folder
                
                -- Второй слой для очертания
                local outline = Instance.new("BoxHandleAdornment")
                outline.Size = Vector3.new(3.4, 5.4, 1.4)
                outline.Adornee = char
                outline.Color3 = COLORS.Black
                outline.Transparency = 0.5
                outline.AlwaysOnTop = Settings.Wallhack
                outline.ZIndex = -1
                outline.Parent = folder
            end
            
            -- Trails (линии от центра экрана до игрока)
            if Settings.ShowTrails then
                local trail = Instance.new("LineHandleAdornment")
                trail.Adornee = char
                trail.Point1 = cam.CFrame.Position
                trail.Point2 = char:FindFirstChild("Head").Position
                trail.Color3 = color
                trail.Thickness = 1.5
                trail.Transparency = 0.4
                trail.AlwaysOnTop = Settings.Wallhack
                trail.Parent = folder
                trailLines[p] = trail
            end
            
            -- Health Bar
            if Settings.ShowHealth then
                local hGui = Instance.new("BillboardGui")
                hGui.Adornee = char:FindFirstChild("Head")
                hGui.Size = UDim2.new(0, 40, 0, 4)
                hGui.StudsOffset = Vector3.new(0, 2.5, 0)
                hGui.Parent = folder
                
                local bg = Instance.new("Frame")
                bg.Size = UDim2.new(1, 0, 1, 0)
                bg.BackgroundColor3 = COLORS.Black
                bg.Parent = hGui
                
                local fill = Instance.new("Frame")
                fill.Size = UDim2.new(1, 0, 1, 0)
                fill.BackgroundColor3 = COLORS.Ally
                fill.Parent = bg
                
                espObjects[p] = {Folder = folder, Health = fill}
            else
                espObjects[p] = {Folder = folder}
            end
        end
        
        -- Обновление данных
        local data = espObjects[p]
        if data and data.Health then
            local hum = char:FindFirstChild("Humanoid")
            if hum then
                data.Health.Size = UDim2.new(hum.Health / hum.MaxHealth, 0, 1, 0)
            end
        end
        
        -- Обновление цвета и Wallhack
        local enemy = isEnemy(p)
        local color = enemy and COLORS.Enemy or COLORS.Ally
        
        for _, child in ipairs(data.Folder:GetChildren()) do
            if child:IsA("Adornment") then
                child.Color3 = color
                child.AlwaysOnTop = Settings.Wallhack
                
                -- Обновление трассеров
                if child:IsA("LineHandleAdornment") and child ~= trailLines[p] then
                    child.Point1 = cam.CFrame.Position
                    child.Point2 = char:FindFirstChild("Head") and char.Head.Position or char.PrimaryPart.Position
                end
            end
        end
        
        -- Обновление трассеров отдельно
        if Settings.ShowTrails and trailLines[p] then
            trailLines[p].Point1 = cam.CFrame.Position
            trailLines[p].Point2 = char:FindFirstChild("Head") and char.Head.Position or char.PrimaryPart.Position
            trailLines[p].Color3 = color
            trailLines[p].AlwaysOnTop = Settings.Wallhack
        end
    end
    
    -- Очистка мертвых игроков
    for p, data in pairs(espObjects) do
        if not p.Character or not p.Character.Parent then
            data.Folder:Destroy()
            if trailLines[p] then
                trailLines[p] = nil
            end
            espObjects[p] = nil
        end
    end
end)

