    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = c

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 45, 0, 22)
    box.Position = UDim2.new(1, -47, 0.5, -11)
    box.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
