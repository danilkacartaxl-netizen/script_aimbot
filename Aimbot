local function createSlider(yPos, text, getter, setter, min, max, suffix)
    local c = Instance.new("Frame")
    c.Size = UDim2.new(0.9, 0, 0, 34)
    c.Position = UDim2.new(0.05, 0, 0, yPos)
    c.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    c.BorderSizePixel = 0
    c.Parent = menu
    
    local cCorner = Instance.new("UICorner")
    cCorner.CornerRadius = UDim.new(0, 4)
    cCorner.Parent = c

    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(0.5, 0, 0.5, 0)
    l.Position = UDim2.new(0.05, 0, 0, 0)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = Color3.fromRGB(200, 200, 200)
    l.Font = Enum.Font.Gotham
    l.TextSize = 10
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = c

    local val = Instance.new("TextLabel")
    val.Size = UDim2.new(0.3, 0, 0.5, 0)
    val.Position = UDim2.new(0.65, 0, 0, 0)
    val.BackgroundTransparency = 1
    val.Text = tostring(getter()) .. (suffix or "")
    val.TextColor3 = menuColors[Settings.menuColor]
    val.Font = Enum.Font.GothamBold
    val.TextSize = 10
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.Parent = c

    local slider = Instance.new("Frame")
    slider.Size = UDim2.new(0.9, 0, 0, 3)
    slider.Position = UDim2.new(0.05, 0, 0.7, 0)
    slider.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    slider.BorderSizePixel = 0
    slider.Parent = c

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((getter() - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = menuColors[Settings.menuColor]
    fill.BorderSizePixel = 0
    fill.Parent = slider

    local dragging = false
    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            local x = math.clamp((input.Position.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
            local value = min + (max - min) * x
            setter(value)
            fill.Size = UDim2.new(x, 0, 1, 0)
            val.Text = tostring(math.round(value * 100) / 100) .. (suffix or "")
        end
    end)

    uis.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    uis.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local x = math.clamp((input.Position.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
            local value = min + (max - min) * x
            setter(value)
            fill.Size = UDim2.new(x, 0, 1, 0)
            val.Text = tostring(math.round(value * 100) / 100) .. (suffix or "")
        end
    end)
end

