local dragging = false
local dragStart
local startPos

btn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = btn.Position
        userInput.MouseIconEnabled = false
    end
end)

btn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
        dragging = false
        userInput.MouseIconEnabled = true
    end
end)

userInput.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)

        if menu.Visible then
            local absX = btn.AbsolutePosition.X
            local screenW = camera.ViewportSize.X
            if absX < screenW / 2 then
                menu.Position = UDim2.new(0, btn.AbsolutePosition.X + 45, 0, btn.AbsolutePosition.Y)
            else
                menu.Position = UDim2.new(0, btn.AbsolutePosition.X - 185, 0, btn.AbsolutePosition.Y)
            end
        end
    end
end)

btn.MouseButton1Click:Connect(function()
