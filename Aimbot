-- ===== ДВИЖЕНИЕ КНОПКИ =====
local dragging = false
local dragStart, startPos

btn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = btn.Position
        uis.MouseIconEnabled = false
    end
end)

btn.InputEnded:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and dragging then
        dragging = false
        uis.MouseIconEnabled = true
    end
end)

uis.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        btn.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
        if menu.Visible then
            local absX = btn.AbsolutePosition.X
            local screenW = cam.ViewportSize.X
            local menuW = menu.AbsoluteSize.X
            if absX < screenW / 2 then
                menu.Position = UDim2.new(0, btn.AbsolutePosition.X + 45, 0, btn.AbsolutePosition.Y)
            else
                menu.Position = UDim2.new(0, btn.AbsolutePosition.X - menuW - 5, 0, btn.AbsolutePosition.Y)
            end
        end
    end
end)

local function toggleMenu()
    menu.Visible = not menu.Visible
    if menu.Visible then
        local absX = btn.AbsolutePosition.X
        local screenW = cam.ViewportSize.X
        local menuW = menu.AbsoluteSize.X
        if absX < screenW / 2 then
            menu.Position = UDim2.new(0, btn.AbsolutePosition.X + 45, 0, btn.AbsolutePosition.Y)
        else
            menu.Position = UDim2.new(0, btn.AbsolutePosition.X - menuW - 5, 0, btn.AbsolutePosition.Y)
        end
    end
end

btn.MouseButton1Click:Connect(toggleMenu)
uis.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.D then toggleMenu() end
end)

-- ===== AUTOFIRE (стрельба по врагу) =====
local function shootTarget(targetPos)
    if not targetPos or not mouse then return end
    local scr = cam:WorldToViewportPoint(targetPos)
    if scr then
        mouse.Move(UDim2.new(0, scr.X, 0, scr.Y))
        mouse.Button1Down()
        task.wait(0.03)
        mouse.Button1Up()
    end
end

-- ===== ГЛАВНЫЙ ЦИКЛ =====
rs.RenderStepped:Connect(function()
    -- ESP
    if esp then
        for _, p in ipairs(players:GetPlayers()) do
            if p ~= plr and p.Character then
                if not highlights[p] then
                    local h = Instance.new("Highlight")
                    h.FillColor = isEnemy(p) and enemyColor or teamColor
                    h.FillTransparency = 0.45
                    h.OutlineColor = Color3.new(1, 1, 1)
                    h.OutlineTransparency = 0.25
                    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    h.Parent = p.Character
                    highlights[p] = h
                    p.CharacterAdded:Connect(function()
                        if highlights[p] then
                            highlights[p]:Destroy()
                            highlights[p] = nil
                        end
                    end)
                else
                    highlights[p].FillColor = isEnemy(p) and enemyColor or teamColor
                end
            end
        end
        for p, h in pairs(highlights) do
            if not p or not p.Character or not h.Parent then
                if h then h:Destroy() end
                highlights[p] = nil
            end
        end
    else
        for _, h in pairs(highlights) do
            if h then h:Destroy() end
        end
        highlights = {}
    end

    -- Поиск цели (общий для аимбота и автоогня)
    local targetPos = nil
    local targetPlayer = nil

    if (aim or autofire) and plr.Character then
        local camPos = cam.CFrame.Position
        local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        local bestDist = math.huge

        for _, p in ipairs(players:GetPlayers()) do
            if p ~= plr and isEnemy(p) and p.Character then
                local head = p.Character:FindFirstChild("Head")
                if head then
                    local scr, onScreen = cam:WorldToViewportPoint(head.Position)
                    if onScreen and scr.Z > 0 then
                        local dist2d = (Vector2.new(scr.X, scr.Y) - center).Magnitude
                        if dist2d <= fovSize then
                            local ok = true
                            if wall then ok = canSee(camPos, head.Position) end
                            -- Wallbang: игнорируем видимость для выстрела
                            if wallbang and autofire then ok = true end
                            if ok and dist2d < bestDist then
                                bestDist = dist2d
                                targetPos = head.Position
                                targetPlayer = p
                            end
                        end
                    end
                end
            end
        end
    end

    -- Aimbot (наведение)
    if aim and targetPos then
        cam.CFrame = CFrame.lookAt(cam.CFrame.Position, targetPos)
    end

    -- Autofire (автоматический выстрел по цели)
    if autofire and targetPos and targetPlayer then
        -- Проверка: если Wallbang выключен, но цель за стеной — не стреляем
        if not wallbang and wall then
            local camPos = cam.CFrame.Position
            local ok = canSee(camPos, targetPos)
            if not ok then targetPos = nil end
        end
        if targetPos then
            shootTarget(targetPos)
        end
    end

    -- КРУГ FOV
    local circleSize = fovSize * 2
    fovCircle.Size = UDim2.new(0, circleSize, 0, circleSize)
    fovCircle.Visible = aim
    fovCircle.Position = UDim2.new(0.5, 0, 0.5, -27)
end)

