-- ===== SPEEDHACK =====
local function applySpeedHack()
    if settings.SpeedHack then
        local hum = player.Character and player.Character:FindFirstChild("Humanoid")
        if hum then
            hum.WalkSpeed = 16 * settings.SpeedMultiplier
        end
    end
end

-- ===== FLY =====
local flyBodyVel = nil
local flyBodyGyro = nil
local flyEnabled = false

local function startFly()
    local char = player.Character
    if not char then return end
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not torso then return end

    flyBodyVel = Instance.new("BodyVelocity")
    flyBodyVel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    flyBodyVel.Velocity = Vector3.new(0, 0, 0)
    flyBodyVel.Parent = torso

    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    flyBodyGyro.P = 1e9
    flyBodyGyro.CFrame = torso.CFrame
    flyBodyGyro.Parent = torso

    flyEnabled = true
    player.Character.Humanoid.PlatformStand = true
end

local function stopFly()
    if flyBodyVel then flyBodyVel:Destroy() flyBodyVel = nil end
    if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
    flyEnabled = false
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.PlatformStand = false
    end
end

-- Управление полётом (WASD + пробел + Shift)
userInput.InputBegan:Connect(function(input, isTyping)
    if isTyping or not flyEnabled then return end
    local speed = settings.FlySpeed
    local vel = Vector3.new(0, 0, 0)
    if input.KeyCode == Enum.KeyCode.W then vel = vel + camera.CFrame.LookVector * speed end
    if input.KeyCode == Enum.KeyCode.S then vel = vel - camera.CFrame.LookVector * speed end
    if input.KeyCode == Enum.KeyCode.A then vel = vel - camera.CFrame.RightVector * speed end
    if input.KeyCode == Enum.KeyCode.D then vel = vel + camera.CFrame.RightVector * speed end
    if input.KeyCode == Enum.KeyCode.Space then vel = vel + Vector3.new(0, speed, 0) end
    if input.KeyCode == Enum.KeyCode.LeftShift then vel = vel - Vector3.new(0, speed, 0) end
    if flyBodyVel then flyBodyVel.Velocity = vel end
end)

-- ===== ОБНОВЛЕНИЕ ВСЕГО (КАЖДЫЙ КАДР) =====
runService.RenderStepped:Connect(function()
    -- FOV круг
    local circleSize = settings.FOV * 2
    fovCircle.Size = UDim2.new(0, circleSize, 0, circleSize)
    fovCircle.Visible = settings.Aimbot
    circleStroke.Color = settings.CircleColor

    -- SpeedHack
    applySpeedHack()

    -- Fly (включение/выключение через меню)
    if settings.Fly and not flyEnabled then
        startFly()
    elseif not settings.Fly and flyEnabled then
        stopFly()
    end

    -- ESP (создание и обновление)
    if settings.ESP then
        for _, plr in ipairs(players:GetPlayers()) do
            if plr ~= player and plr.Character and not espObjects[plr] then
                createESP(plr)
            end
        end
        for plr, data in pairs(espObjects) do
            if not plr.Character or not plr.Character.Parent then
                data.Folder:Destroy()
                espObjects[plr] = nil
            else
                local hum = plr.Character:FindFirstChild("Humanoid")
                if hum then
                    data.Health.Size = UDim2.new(hum.Health / hum.MaxHealth, 0, 1, 0)
                end
            end
        end
    else
        for _, data in pairs(espObjects) do
            data.Folder:Destroy()
        end
        espObjects = {}
    end
end)

-- ===== AIMBOT =====
local function getClosestPlayer()
    local closest, shortest = nil, settings.FOV
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

    for _, plr in ipairs(players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
            local part = plr.Character:FindFirstChild(settings.AimPart == "Head" and "Head" or "UpperTorso") or plr.Character:FindFirstChild(settings.AimPart == "Head" and "Head" or "Torso")
            if part then
                local pos, onScreen = camera:WorldToViewportPoint(part.Position)
                if onScreen and pos.Z > 0 then
                    local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if dist < shortest then
                        local ok = true
                        if settings.Wallhack then
                            local camPos = camera.CFrame.Position
                            local direction = part.Position - camPos
                            local ray = Ray.new(camPos, direction)
                            local hit = workspace:FindPartOnRayWithIgnoreList(ray, {player.Character})
                            if hit then ok = false end
                        end
                        if ok then
                            shortest = dist
                            closest = plr
                        end
                    end
                end
            end
        end
    end
    return closest
end

runService.RenderStepped:Connect(function()
    if not settings.Aimbot then return end

    local target = getClosestPlayer()
    if target then
        local aimPartObj = target.Character:FindFirstChild(settings.AimPart == "Head" and "Head" or "UpperTorso") or target.Character:FindFirstChild(settings.AimPart == "Head" and "Head" or "Torso")
        if aimPartObj then
            local aimPos = aimPartObj.Position
            local camPos = camera.CFrame.Position
            local direction = (aimPos - camPos).Unit
            local targetCFrame = CFrame.new(camPos, camPos + direction)
            camera.CFrame = camera.CFrame:Lerp(targetCFrame, settings.Smooth)

            -- TAP FIRE
            if settings.TapFire then
                local args = {
                    target.Character,
                    aimPartObj.Position,
                    "Auto"
                }
                -- Имитация клика (если игра использует RemoteEvent)
                -- ВНИМАНИЕ: конкретные названия событий зависят от игры!
                local remote = game:GetService("ReplicatedStorage"):FindFirstChild("Fire")
                if remote then
                    remote:FireServer(unpack(args))
                else
                    -- Если нет RemoteEvent, просто имитируем нажатие мыши
                    mouse1click()
                end
            end
        end
    end
end)

