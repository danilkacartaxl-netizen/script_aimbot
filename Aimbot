    return Color3.fromRGB(50, 150, 255)
end

RunService.RenderStepped:Connect(function()
    -- ESP
    if Toggles.ESPEnemies or Toggles.ESPAllies then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                if not ESPObjects[p] then
                    local folder = Instance.new("Folder")
                    folder.Name = "WinstikESP"
                    folder.Parent = p.Character
                    ESPObjects[p] = folder
                    
                    -- Хайлайт
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "ESP_Highlight"
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Parent = folder
                    
                    -- Бокс
                    local box = Instance.new("BoxHandleAdornment")
                    box.Name = "ESP_Box"
                    box.Size = Vector3.new(3, 5, 1)
                    box.Adornee = p.Character
                    box.Transparency = 0.2
                    box.AlwaysOnTop = Toggles.Wallhack
                    box.Parent = folder
                    
                    -- Имя
                    local nameGui = Instance.new("BillboardGui")
                    nameGui.Name = "ESP_Name"
                    nameGui.Adornee = p.Character:FindFirstChild("Head")
                    nameGui.Size = UDim2.new(0, 100, 0, 20)
                    nameGui.StudsOffset = Vector3.new(0, 2.5, 0)
                    nameGui.Parent = folder
                    
                    local nameLabel = Instance.new("TextLabel")
                    nameLabel.Size = UDim2.new(1, 0, 1, 0)
                    nameLabel.BackgroundTransparency = 1
                    nameLabel.Text = p.Name
                    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                    nameLabel.Font = Enum.Font.GothamBold
                    nameLabel.TextScaled = true
                    nameLabel.Parent = nameGui
                else
                    local folder = ESPObjects[p]
                    local highlight = folder:FindFirstChild("ESP_Highlight")
                    local box = folder:FindFirstChild("ESP_Box")
                    local nameGui = folder:FindFirstChild("ESP_Name")
                    
                    if Toggles.ESPEnemies and getEnemyColor(p) then
                        if highlight then highlight.FillColor = Color3.fromRGB(255, 50, 50) end
                        if box then box.Color3 = Color3.fromRGB(255, 50, 50) end
                        if nameGui then nameGui.Enabled = Toggles.ESPName end
                        if highlight then highlight.Enabled = true end
                        if box then box.Enabled = Toggles.ESPBox end
                    elseif Toggles.ESPAllies and getAllyColor(p) then
                        if highlight then highlight.FillColor = Color3.fromRGB(50, 150, 255) end
                        if box then box.Color3 = Color3.fromRGB(50, 150, 255) end
                        if nameGui then nameGui.Enabled = Toggles.ESPName end
                        if highlight then highlight.Enabled = true end
                        if box then box.Enabled = Toggles.ESPBox end
                    else
                        if highlight then highlight.Enabled = false end
                        if box then box.Enabled = false end
                        if nameGui then nameGui.Enabled = false end
                    end
                end
            end
        end
    else
        for p, folder in pairs(ESPObjects) do
            if folder then folder:Destroy() end
            ESPObjects[p] = nil
        end
    end
    
    -- Aimbot
    if Toggles.Aimbot then
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local bestTarget = nil
        local bestDist = Settings.FOV
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local head = p.Character:FindFirstChild("Head")
                if head then
                    local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen and pos.Z > 0 then
                        local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if dist < bestDist and (Toggles.ESPEnemies or Toggles.ESPAllies) then
                            bestDist = dist
                            bestTarget = head
                        end
                    end
                end
            end
        end
        
        if bestTarget then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, bestTarget.Position)
        end
    end
    
    -- Spin 360
    if Toggles.Spin and LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(Settings.SpinSpeed), 0)
        end
    end
    
    -- Fog
    if Toggles.Fog then
        if not FogEffect then
            FogEffect = Instance.new("Atmosphere")
            FogEffect.Name = "WinstikFog"
            FogEffect.Color = Color3.fromRGB(255, 255, 255)
            FogEffect.Density = Settings.FogDensity
            FogEffect.Parent = Lighting
        else
            FogEffect.Density = Settings.FogDensity
        end
    else
        if FogEffect then
            FogEffect:Destroy()
            FogEffect = nil
        end
    end
end)

