-- ESP Library by linemaster2
-- https://github.com/linemaster2/esp-library

local ESP = {}
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- Настройки по умолчанию
ESP.Settings = {
    Enabled = false,
    Color = Color3.fromRGB(255, 0, 0),
    Transparency = 0.5,
    Thickness = 2,
    ShowName = true,
    ShowHealth = true,
    ShowBox = true,
    ShowSkeleton = true,
    AlwaysOnTop = false
}

-- Хранилище объектов ESP
local ESPObjects = {}

-- Создание ESP для игрока
function ESP:AddPlayer(plr)
    if not plr or not plr.Character then return end
    if ESPObjects[plr] then return end
    
    local char = plr.Character
    local folder = Instance.new("Folder")
    folder.Name = "ESP_" .. plr.Name
    folder.Parent = char
    
    -- Бокс
    if ESP.Settings.ShowBox then
        local box = Instance.new("BoxHandleAdornment")
        box.Size = Vector3.new(3, 5, 1)
        box.Adornee = char
        box.Color3 = ESP.Settings.Color
        box.Transparency = ESP.Settings.Transparency
        box.AlwaysOnTop = ESP.Settings.AlwaysOnTop
        box.Parent = folder
    end
    
    -- Скелет
    if ESP.Settings.ShowSkeleton then
        local function createLine(p1, p2)
            local line = Instance.new("LineHandleAdornment")
            line.Adornee = char
            line.Point1 = p1.Position
            line.Point2 = p2.Position
            line.Color3 = ESP.Settings.Color
            line.Thickness = ESP.Settings.Thickness
            line.Transparency = ESP.Settings.Transparency
            line.AlwaysOnTop = ESP.Settings.AlwaysOnTop
            line.Parent = folder
            return line
        end
        
        local head = char:FindFirstChild("Head")
        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        local la = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftUpperArm")
        local ra = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightUpperArm")
        local ll = char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftLowerLeg")
        local rl = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightLowerLeg")
        
        if head and torso then
            createLine(head, torso)
            if la then createLine(torso, la) end
            if ra then createLine(torso, ra) end
            if ll then createLine(torso, ll) end
            if rl then createLine(torso, rl) end
        end
    end
    
    -- Имя
    if ESP.Settings.ShowName then
        local nameGui = Instance.new("BillboardGui")
        nameGui.Adornee = char:FindFirstChild("Head")
        nameGui.Size = UDim2.new(0, 100, 0, 20)
        nameGui.StudsOffset = Vector3.new(0, 2.5, 0)
        nameGui.Parent = folder
        
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 1, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = plr.Name
        nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLabel.TextScaled = true
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.Parent = nameGui
    end
    
    -- Здоровье
    if ESP.Settings.ShowHealth then
        local healthGui = Instance.new("BillboardGui")
        healthGui.Adornee = char:FindFirstChild("Head")
        healthGui.Size = UDim2.new(0, 50, 0, 4)
        healthGui.StudsOffset = Vector3.new(0, 2, 0)
        healthGui.Parent = folder
        
        local bg = Instance.new("Frame")
        bg.Size = UDim2.new(1, 0, 1, 0)
        bg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        bg.Parent = healthGui
        
        local fill = Instance.new("Frame")
        fill.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        fill.Size = UDim2.new(1, 0, 1, 0)
        fill.Parent = bg
        
        ESPObjects[plr] = {Folder = folder, Health = fill, Player = plr}
    else
        ESPObjects[plr] = {Folder = folder, Player = plr}
    end
end

-- Удаление ESP для игрока
function ESP:RemovePlayer(plr)
    if ESPObjects[plr] then
        ESPObjects[plr].Folder:Destroy()
        ESPObjects[plr] = nil
    end
end

-- Обновление ESP
function ESP:Update()
    for plr, data in pairs(ESPObjects) do
        if not plr.Character or not plr.Character.Parent then
            data.Folder:Destroy()
            ESPObjects[plr] = nil
        elseif ESP.Settings.ShowHealth and data.Health then
            local hum = plr.Character:FindFirstChild("Humanoid")
            if hum then
                data.Health.Size = UDim2.new(hum.Health / hum.MaxHealth, 0, 1, 0)
            end
        end
    end
end

-- Включение/выключение ESP
function ESP:Toggle(state)
    ESP.Settings.Enabled = state
    if state then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                self:AddPlayer(plr)
            end
        end
    else
        for plr, data in pairs(ESPObjects) do
            data.Folder:Destroy()
        end
        ESPObjects = {}
    end
end

-- Изменение цвета
function ESP:SetColor(color)
    ESP.Settings.Color = color
    for plr, data in pairs(ESPObjects) do
        if data.Folder then
            for _, child in ipairs(data.Folder:GetChildren()) do
                if child:IsA("Adornment") then
                    child.Color3 = color
                end
            end
        end
    end
end

-- Автоматическое обновление
Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function()
        if ESP.Settings.Enabled then
            ESP:AddPlayer(plr)
        end
    end)
end)

RunService.RenderStepped:Connect(function()
    if ESP.Settings.Enabled then
        ESP:Update()
    end
end)

return ESP
