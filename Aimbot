-- ===== ФУНКЦИЯ СОЗДАНИЯ КНОПОК =====
local function makeToggle(name, y, def, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 260, 0, 45)
    b.Position = UDim2.new(0, 10, 0, y)
    b.BackgroundColor3 = def and Color3.fromRGB(51, 51, 51) or Color3.fromRGB(25, 25, 25)
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.Text = name .. ": " .. (def and "ON" or "OFF")
    b.Font = Enum.Font.SourceSansBold
    b.TextSize = 20
    b.BorderSizePixel = 0
    b.Parent = menu

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 10)
    c.Parent = b

    b.MouseButton1Click:Connect(function()
        def = not def
        b.BackgroundColor3 = def and Color3.fromRGB(51, 51, 51) or Color3.fromRGB(25, 25, 25)
        b.Text = name .. ": " .. (def and "ON" or "OFF")
        if callback then callback(def) end
    end)
    return b
end

