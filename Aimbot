-- 7. ЛОГИКА ИГРЫ (AIMBOT, ESP, FOG, SPIN, AUTOFIRE)
-- ==============================================
local function getTeam(player)
    if not player or not player.Character then return nil end
    local name = player.Name:lower()
    if name:find("sheriff") then return "Sheriff"
    elseif name:find("murderer") or name:find("kill") then return "Murderer"
    end
    local myTeam = plr.Team
    if myTeam and player.Team == myTeam then return "Ally"
    else return "Enemy" end
end

local function isEnemy(player)
    if player == plr then return false end
    local myTeam = getTeam(plr)
    local theirTeam = getTeam(player)
    if myTeam == "Ally" or theirTeam == "Ally" then return myTeam ~= theirTeam end
    return theirTeam ~= myTeam
end

local function canSee(pos1, pos2)
    local ray = Ray.new(pos1, pos2 - pos1)
    local part, hit = ws:FindPartOnRayWithIgnoreList(ray, {plr.Character})
    return (hit - pos1).Magnitude >= (pos2 - pos1).Magnitude - 2
end

local function shootTarget(targetPos)
    if not targetPos or not mouse then return end
    local scr = cam:WorldToViewportPoint(targetPos)
    if scr then
        mouse.Move(UDim2.new(0, scr.X, 0, scr.Y))
        mouse.Button1Down()
        task.wait(0.03)
        mouse.Button1Up()
    end
end

rs.RenderStepped:Connect(function()
    -- Туман
    if Settings.fog then
        if not fogFolder then
            fogFolder = Instance.new("Atmosphere")
            fogFolder.Name = "SWILL_Fog"
            fogFolder.Color = Settings.fogColor
            fogFolder.Density = 0.5
            fogFolder.Offset = 0
            fogFolder.Parent = lighting
        end
    else
        if fogFolder then
            fogFolder:Destroy()
            fogFolder = nil
        end
    end
    
    -- Спин 360 (Вращение)
    if Settings.spin and plr.Character then
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(5), 0)
        end
    end

    -- Круг FOV
    local circleSize = Settings.fovSize * 2
    fovCircle.Size = UDim2.new(0, circleSize, 0, circleSize)
    fovCircle.Visible = Settings.aimbot

    -- ESP
    if Settings.esp then
        for _, p in ipairs(players:GetPlayers()) do
            if p ~= plr and p.Character then
                if not highlights[p] then
                    local h = Instance.new("Highlight")
                    h.FillColor = isEnemy(p) and Settings.espColor or teamColor
                    h.FillTransparency = 0.45
                    h.OutlineColor = Color3.new(1, 1, 1)
                    h.OutlineTransparency = 0.25
                    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    h.Parent = p.Character
                    highlights[p] = h
                    p.CharacterAdded:Connect(function()
                        if highlights[p] then
                            highlights[p]:Destroy()
                            highlights[p] = nil
                        end
                    end)
                else
                    highlights[p].FillColor = isEnemy(p) and Settings.espColor or teamColor
                end
            end
        end
        for p, h in pairs(highlights) do
            if not p or not p.Character or not h.Parent then
                if h then h:Destroy() end
                highlights[p] = nil
            end
        end
    else
        for _, h in pairs(highlights) do
            if h then h:Destroy() end
        end
        highlights = {}
    end

    -- Поиск цели (Aimbot + Autofire)
    local targetPos = nil
    local targetPlayer = nil

    if (Settings.aimbot or Settings.autofire) and plr.Character then
        local camPos = cam.CFrame.Position
        local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        local bestDist = math.huge

        for _, p in ipairs(players:GetPlayers()) do
            if p ~= plr and isEnemy(p) and p.Character then
                local head = p.Character:FindFirstChild("Head")
                if head then
                    local scr, onScreen = cam:WorldToViewportPoint(head.Position)
                    if onScreen and scr.Z > 0 then
                        local dist2d = (Vector2.new(scr.X, scr.Y) - center).Magnitude
                        if dist2d <= Settings.fovSize then
                            local ok = true
                            if Settings.wall then ok = canSee(camPos, head.Position) end
                            if Settings.wallbang and Settings.autofire then ok = true end
                            if ok and dist2d < bestDist then
                                bestDist = dist2d
                                targetPos = head.Position
                                targetPlayer = p
                            end
                        end
                    end
                end
            end
        end
    end

    -- Аимбот (Наведение)
    if Settings.aimbot and targetPos then
        cam.CFrame = CFrame.lookAt(cam.CFrame.Position, targetPos)
    end

    -- Autofire (Стрельба)
    if Settings.autofire and targetPos and targetPlayer then
        if not Settings.wallbang and Settings.wall then
            local camPos = cam.CFrame.Position
            local ok = canSee(camPos, targetPos)
            if not ok then targetPos = nil end
        end
        if targetPos then
            shootTarget(targetPos)
        end
    end
end)

