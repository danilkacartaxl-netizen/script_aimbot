-- Dragging
local dragging = false
local dragStart, startPos

btn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = btn.Position
        uis.MouseIconEnabled = false
    end
end)

btn.InputEnded:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and dragging then
        dragging = false
        uis.MouseIconEnabled = true
    end
end)

uis.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        btn.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
        if menu.Visible then
            local absX = btn.AbsolutePosition.X
            local screenW = cam.ViewportSize.X
            local menuW = menu.AbsoluteSize.X
            if absX < screenW / 2 then
                menu.Position = UDim2.new(0, btn.AbsolutePosition.X + 42, 0, btn.AbsolutePosition.Y)
            else
                menu.Position = UDim2.new(0, btn.AbsolutePosition.X - menuW - 6, 0, btn.AbsolutePosition.Y)
            end
        end
    end
end)

local function toggleMenu()
    menu.Visible = not menu.Visible
    if menu.Visible then
        local absX = btn.AbsolutePosition.X
        local screenW = cam.ViewportSize.X
        local menuW = menu.AbsoluteSize.X
        if absX < screenW / 2 then
            menu.Position = UDim2.new(0, btn.AbsolutePosition.X + 42, 0, btn.AbsolutePosition.Y)
        else
            menu.Position = UDim2.new(0, btn.AbsolutePosition.X - menuW - 6, 0, btn.AbsolutePosition.Y)
        end
    end
end

btn.MouseButton1Click:Connect(toggleMenu)
uis.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.D or input.KeyCode == Enum.KeyCode.B then toggleMenu() end
end)

-- NoClip
local function setNoClip(enabled)
    if not plr.Character then return end
    for _, part in ipairs(plr.Character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not enabled
        end
    end
end

-- Weapon ESP
local function updateWeaponESP()
    for _, h in pairs(weaponHighlights) do
        if h then h:Destroy() end
    end
    weaponHighlights = {}
    
    if not weaponEsp then return end
    
    for _, item in ipairs(ws:GetDescendants()) do
        if item:IsA("Tool") and item.Parent ~= plr.Character then
            local handle = item:FindFirstChild("Handle")
            if handle then
                local h = Instance.new("Highlight")
                h.FillColor = Color3.new(1, 0.8, 0)
                h.FillTransparency = 0.3
                h.OutlineColor = Color3.new(1, 1, 1)
                h.OutlineTransparency = 0.2
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Parent = handle
                table.insert(weaponHighlights, h)
            end
        end
    end
    
    for _, player in ipairs(players:GetPlayers()) do
        if player ~= plr and player.Character then
            local tool = player.Character:FindFirstChildOfClass("Tool")
            if tool then
                local handle = tool:FindFirstChild("Handle")
                if handle then
                    local h = Instance.new("Highlight")
                    h.FillColor = Color3.new(1, 0.8, 0)
                    h.FillTransparency = 0.3
                    h.OutlineColor = Color3.new(1, 1, 1)
                    h.OutlineTransparency = 0.2
                    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    h.Parent = handle
                    table.insert(weaponHighlights, h)
                end
            end
        end
    end
end

-- AutoKill (only for Murderer)
local function autoKillAll()
    if getRole(plr) ~= "Murderer" then 
        return 
    end
    
    if not plr.Character then return end
    local tool = plr.Character:FindFirstChildOfClass("Tool")
    if not tool then return end
    local mouse = plr:GetMouse()
    if not mouse then return end
    
    for _, p in ipairs(players:GetPlayers()) do
        if p ~= plr and isEnemy(p) and p.Character then
            local head = p.Character:FindFirstChild("Head")
            if head then
                local oldHit = mouse.Hit
                mouse.Hit = CFrame.new(head.Position)
                mouse.Button1Down:Fire()
                mouse.Button1Up:Fire()
                mouse.Hit = oldHit
                task.wait(0.05)
            end
        end
    end
end

-- Main Loop
rs.RenderStepped:Connect(function()
    setNoClip(noClip)
    
    -- ESP
    if esp then
        for _, p in ipairs(players:GetPlayers()) do
            if p ~= plr and p.Character then
                if not highlights[p] then
                    local h = Instance.new("Highlight")
                    h.FillColor = getRoleColor(p)
                    h.FillTransparency = 0.4
                    h.OutlineColor = Color3.new(1, 1, 1)
                    h.OutlineTransparency = 0.15
                    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    h.Parent = p.Character
                    highlights[p] = h
                    p.CharacterAdded:Connect(function()
                        if highlights[p] then
                            highlights[p]:Destroy()
                            highlights[p] = nil
                        end
                    end)
                else
                    highlights[p].FillColor = getRoleColor(p)
                end
            end
        end
        for p, h in pairs(highlights) do
            if not p or not p.Character or not h.Parent then
                if h then h:Destroy() end
                highlights[p] = nil
            end
        end
    else
        for _, h in pairs(highlights) do
            if h then h:Destroy() end
        end
        highlights = {}
    end
    
    -- Weapon ESP
    if weaponEsp then
        updateWeaponESP()
    else
        for _, h in pairs(weaponHighlights) do
            if h then h:Destroy() end
        end
        weaponHighlights = {}
    end
    
    -- AutoKill
    if autoKill then
        autoKillAll()
    end
    
    -- Aimbot
    if aim and plr.Character then
        local camPos = cam.CFrame.Position
        local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        local best = nil
        local bestDist = math.huge
        
        for _, p in ipairs(players:GetPlayers()) do
            if p ~= plr and isEnemy(p) and p.Character then
                local head = p.Character:FindFirstChild("Head")
                if head then
                    local scr, onScreen = cam:WorldToViewportPoint(head.Position)
                    if onScreen and scr.Z > 0 then
                        local dist2d = (Vector2.new(scr.X, scr.Y) - center).Magnitude
                        if dist2d <= fovSize then
                            if dist2d < bestDist then
                                bestDist = dist2d
                                best = head.Position
                            end
                        end
                    end
                end
            end
        end
        
        if best then
            cam.CFrame = CFrame.lookAt(camPos, best)
        end
    end
    
    -- FOV Circle
    local circleSize = fovSize * 2
    fovCircle.Size = UDim2.new(0, circleSize, 0, circleSize)
    fovCircle.Visible = aim
end)

