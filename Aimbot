-- ===== AIMBOT ЛОГИКА =====
local function getClosestPlayer()
    local closest = nil
    local shortestDist = settings.FOV
    
    for _, plr in ipairs(game.Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
            if settings.TeamCheck and plr.Team == player.Team then continue end
            
            local part = plr.Character:FindFirstChild(settings.AimPart)
            if part then
                local pos, onScreen = camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(mouse.X, mouse.Y)).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closest = plr
                    end
                end
            end
        end
    end
    return closest
end

-- Наводка (плавная)
game:GetService("RunService").RenderStepped:Connect(function()
    if not settings.Aimbot then return end
    if not mouse.Target then return end
    
    local target = getClosestPlayer()
    if target then
        local aimPart = target.Character:FindFirstChild(settings.AimPart)
        if aimPart then
            local aimPos = aimPart.Position
            local currentPos = camera.CFrame.Position
            local direction = (aimPos - currentPos).Unit
            local targetCFrame = CFrame.new(currentPos, currentPos + direction)
            
            -- Плавная интерполяция (smooth)
            camera.CFrame = camera.CFrame:Lerp(targetCFrame, settings.Smooth)
        end
    end
end)

-- ===== ESP ЛОГИКА =====
local espObjects = {}

local function createESP(plr)
    if espObjects[plr] then return end
    
    local char = plr.Character
    if not char then return end
    
    local folder = Instance.new("Folder")
    folder.Name = "SWILL_ESP"
    folder.Parent = char
    
    -- Box
    local box = Instance.new("BoxHandleAdornment")
    box.Size = Vector3.new(3, 5, 1)
    box.Adornee = char
    box.Color3 = Color3.fromRGB(200, 0, 0)
    box.Transparency = 0.3
    box.ZIndex = 0
    box.Parent = folder
    
    -- Имя
    local nameLabel = Instance.new("BillboardGui")
    nameLabel.Adornee = char:FindFirstChild("Head")
    nameLabel.Size = UDim2.new(0, 100, 0, 30)
    nameLabel.StudsOffset = Vector3.new(0, 3, 0)
    nameLabel.Parent = folder
    
    local nameText = Instance.new("TextLabel")
    nameText.Size = UDim2.new(1, 0, 1, 0)
    nameText.BackgroundTransparency = 1
    nameText.Text = plr.Name
    nameText.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameText.TextScaled = true
    nameText.Font = Enum.Font.GothamBold
    nameText.Parent = nameLabel
    
    -- Здоровье (полоска)
    local healthBar = Instance.new("BillboardGui")
    healthBar.Adornee = char:FindFirstChild("Head")
    healthBar.Size = UDim2.new(0, 50, 0, 5)
    healthBar.StudsOffset = Vector3.new(0, 2.5, 0)
    healthBar.Parent = folder
    
    local healthBg = Instance.new("Frame")
    healthBg.Size = UDim2.new(1, 0, 1, 0)
    healthBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    healthBg.Parent = healthBar
    
    local healthFill = Instance.new("Frame")
    healthFill.Size = UDim2.new(1, 0, 1, 0)
    healthFill.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
    healthFill.Parent = healthBg
    
    espObjects[plr] = {
        Folder = folder,
        Health = healthFill,
        Char = char
    }
end

local function updateESP()
    for plr, data in pairs(espObjects) do
        if not plr.Character or not plr.Character.Parent then
            data.Folder:Destroy()
            espObjects[plr] = nil
        else
            local hum = plr.Character:FindFirstChild("Humanoid")
            if hum then
                local health = hum.Health / hum.MaxHealth
                data.Health.Size = UDim2.new(health, 0, 1, 0)
            end
        end
    end
end

-- Добавление ESP для новых игроков
game.Players.PlayerAdded:Connect(function(plr)
    if settings.ESP then
        plr.CharacterAdded:Connect(function(char)
            wait(0.5)
            createESP(plr)
        end)
    end
end)

-- Обновление ESP
game:GetService("RunService").RenderStepped:Connect(function()
    if settings.ESP then
        for _, plr in ipairs(game.Players:GetPlayers()) do
            if plr ~= player and not espObjects[plr] then
                createESP(plr)
            end
        end
        updateESP()
    else
        for _, data in pairs(espObjects) do
            data.Folder:Destroy()
        end
        espObjects = {}
    end
end)

