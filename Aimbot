-- ==============================================
-- ПЕРЕТАСКИВАНИЕ ОКНА (DRAG)
-- ==============================================
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isDragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                isDragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and isDragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

-- ==============================================
-- ОТКРЫТИЕ/ЗАКРЫТИЕ (B ИЛИ D)
-- ==============================================
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.B or input.KeyCode == Enum.KeyCode.D then
        MainFrame.Visible = not MainFrame.Visible
        Blur.Visible = MainFrame.Visible
        if fovCircleDraw then
            fovCircleDraw.Visible = MainFrame.Visible
        end
    end
end)

-- ==============================================
-- ЛОГИКА ИГРЫ (АИМБОТ, ESP)
-- ==============================================
local function drawFOVCircle()
    if fovCircleDraw then fovCircleDraw:Destroy() fovCircleDraw = nil end
    if not Settings.Aimbot then return end
    
    fovCircleDraw = Instance.new("Frame")
    fovCircleDraw.Size = UDim2.new(0, Settings.FOV * 2, 0, Settings.FOV * 2)
    fovCircleDraw.Position = UDim2.new(0.5, -Settings.FOV, 0.5, -Settings.FOV)
    fovCircleDraw.BackgroundTransparency = 1
    fovCircleDraw.BorderSizePixel = 0
    fovCircleDraw.ZIndex = 999
    fovCircleDraw.Parent = ScreenGui
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1, 0)
    c.Parent = fovCircleDraw
    
    local s = Instance.new("UIStroke")
    s.Color = Settings.AccentColor
    s.Thickness = 1
    s.Transparency = 0.5
    s.Parent = fovCircleDraw
end

local function isEnemy(player)
    if player == LocalPlayer then return false end
    if not player.Character then return false end
    local name = player.Name:lower()
    if name:find("murderer") or name:find("killer") then return true end
    local tool = player.Character:FindFirstChildOfClass("Tool")
    if tool and tool.Name:lower():find("knife") then return true end
    return false
end

RunService.RenderStepped:Connect(function()
    drawFOVCircle()
    if fovCircleDraw then
        fovCircleDraw.Size = UDim2.new(0, Settings.FOV * 2, 0, Settings.FOV * 2)
        fovCircleDraw.Position = UDim2.new(0.5, -Settings.FOV, 0.5, -Settings.FOV)
    end
    
    -- ESP
    if Settings.ESP then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local head = p.Character:FindFirstChild("Head")
                if head then
                    if not highlightObjects[p] then
                        local h = Instance.new("Highlight")
                        h.Name = "WinstikESP"
                        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        h.Parent = head
                        highlightObjects[p] = h
                    end
                    highlightObjects[p].FillColor = isEnemy(p) and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(50, 200, 255)
                    highlightObjects[p].OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlightObjects[p].FillTransparency = 0.35
                    highlightObjects[p].OutlineTransparency = 0.1
                end
            end
        end
    else
        for _, h in pairs(highlightObjects) do if h then h:Destroy() end end
        highlightObjects = {}
    end
    
    -- Aimbot
    if Settings.Aimbot then
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local bestTarget, bestDist = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and isEnemy(p) and p.Character then
                local head = p.Character:FindFirstChild("Head")
                if head then
                    local scr, on = Camera:WorldToViewportPoint(head.Position)
                    if on and scr.Z > 0 then
                        local dist = (Vector2.new(scr.X, scr.Y) - center).Magnitude
                        if dist <= Settings.FOV and dist < bestDist then
                            bestDist, bestTarget = dist, head
                        end
                    end
                end
            end
        end
        if bestTarget then Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, bestTarget.Position) end
    end
    
    -- NoClip
    if Settings.NoClip and LocalPlayer.Character then
        for _, p in ipairs(LocalPlayer.Character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
    
    -- AutoKill (Нажимает левую кнопку мыши на врагов, если есть оружие)
    if Settings.AutoKill and LocalPlayer.Character then
        local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then
            local mouse = LocalPlayer:GetMouse()
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and isEnemy(p) and p.Character then
                    local head = p.Character:FindFirstChild("Head")
                    if head then
                        local oldHit = mouse.Hit
                        mouse.Hit = CFrame.new(head.Position)
                        mouse.Button1Down:Fire()
                        mouse.Button1Up:Fire()
                        mouse.Hit = oldHit
                        task.wait(0.1)
                    end
                end
            end
        end
    end
end)

