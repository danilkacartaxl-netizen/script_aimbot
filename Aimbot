    dotStroke.Transparency = 0.9
    dotStroke.Thickness = 1.5
    dotStroke.Parent = dot
    
    dot.MouseButton1Click:Connect(function()
        Settings.AccentColor = color
        -- Обновить цвета во всем GUI
        MainStroke.Color = color
        for _, btn in ipairs(Sidebar:GetChildren()) do
            if btn:IsA("TextButton") and btn:FindFirstChild("TextLabel") then
                if ActiveButton == btn then
                    btn:FindFirstChild("TextLabel").TextColor3 = color
                end
            end
        end
        -- Обновить тумблеры
        for _, toggle in ipairs(MainFrame:GetDescendants()) do
            if toggle:IsA("TextButton") and toggle.Size.X.Offset == 32 then
                if toggle.BackgroundColor3 ~= Color3.fromRGB(50, 50, 50) then
                    toggle.BackgroundColor3 = color
                end
            end
            if toggle:IsA("Frame") and toggle.Size.Y.Offset == 3 then
                local fill = toggle:FindFirstChild("Frame")
                if fill then
                    fill.BackgroundColor3 = color
                end
            end
        end
    end)
    return dot
end

