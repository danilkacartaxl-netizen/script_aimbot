-- Aimbot функция
local function GetClosestEnemy()
    local closest = nil
    local closestDist = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            -- Проверка команды для MVsD
            if player.Team and LocalPlayer.Team then
                if player.Team.Name == LocalPlayer.Team.Name then
                    continue
                end
            end
            
            local head = player.Character:FindFirstChild("Head")
            if head then
                local headPos = head.Position
                local screenPos, onScreen = Camera:WorldToViewportPoint(headPos)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
                    if dist < Config.FOV and dist < closestDist then
                        closestDist = dist
                        closest = player
                    end
                end
            end
        end
    end
    
    return closest
end

-- Aimbot логика
RunService.RenderStepped:Connect(function()
    if Config.Aimbot then
        local target = GetClosestEnemy()
        if target and target.Character then
            local head = target.Character:FindFirstChild("Head")
            if head then
                local headPos = head.Position + Vector3.new(0, 0.5, 0)
                local lookAt = (headPos - Camera.CFrame.Position).unit
                local targetCFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + lookAt)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, Config.Smooth)
            end
        end
    end
end)

