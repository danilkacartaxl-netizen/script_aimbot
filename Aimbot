-- ESP (2D BOXES, TRAILS, WALLHACK)
-- ==========================================
local function createESP(plr)
    if espObjects[plr] or not plr.Character then return end
    local char = plr.Character
    local folder = Instance.new("Folder")
    folder.Name = "WINSTIK_ESP"
    folder.Parent = char

    if settings.ShowBoxes then
        local box = Instance.new("BoxHandleAdornment")
        box.Size = Vector3.new(3.2, 5.2, 1.2)
        box.Adornee = char
        box.Color3 = ESP_COLOR
        box.Transparency = 0.15
        box.AlwaysOnTop = settings.Wallhack
        box.Parent = folder
        
        local outline = Instance.new("BoxHandleAdornment")
        outline.Size = Vector3.new(3.6, 5.6, 1.6)
        outline.Adornee = char
        outline.Color3 = Color3.fromRGB(0, 0, 0)
        outline.Transparency = 0.4
        outline.AlwaysOnTop = settings.Wallhack
        outline.ZIndex = -1
        outline.Parent = folder
    end

    if settings.ShowSkeleton then
        local function addLine(p1, p2)
            if not p1 or not p2 then return end
            local line = Instance.new("LineHandleAdornment")
            line.Adornee = char
            line.Point1 = p1.Position
            line.Point2 = p2.Position
            line.Color3 = ESP_COLOR
            line.Thickness = 1.5
            line.Transparency = 0.3
            line.AlwaysOnTop = settings.Wallhack
            line.Parent = folder
        end
        local head = char:FindFirstChild("Head")
        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        local la = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftUpperArm")
        local ra = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightUpperArm")
        local ll = char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftLowerLeg")
        local rl = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightLowerLeg")
        if head and torso then
            addLine(head, torso)
            if la then addLine(torso, la) end
            if ra then addLine(torso, ra) end
            if ll then addLine(torso, ll) end
            if rl then addLine(torso, rl) end
        end
    end

    if settings.ShowTrails then
        local trail = Instance.new("LineHandleAdornment")
        trail.Adornee = char
        trail.Point1 = camera.CFrame.Position
        trail.Point2 = char:FindFirstChild("Head") and char.Head.Position or char.PrimaryPart.Position
        trail.Color3 = ESP_COLOR
        trail.Thickness = 1.5
        trail.Transparency = 0.3
        trail.AlwaysOnTop = settings.Wallhack
        trail.Parent = folder
        trailObjects[plr] = trail
    end

    if settings.ShowNames then
        local nameGui = Instance.new("BillboardGui")
        nameGui.Adornee = char:FindFirstChild("Head")
        nameGui.Size = UDim2.new(0, 100, 0, 20)
        nameGui.StudsOffset = Vector3.new(0, 2.8, 0)
        nameGui.Parent = folder
        
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 1, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = plr.Name
        nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLabel.TextScaled = true
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.Parent = nameGui
    end

    if settings.ShowHealth then
        local healthGui = Instance.new("BillboardGui")
        healthGui.Adornee = char:FindFirstChild("Head")
        healthGui.Size = UDim2.new(0, 40, 0, 4)
        healthGui.StudsOffset = Vector3.new(0, 2.2, 0)
        healthGui.Parent = folder
        
        local bg = Instance.new("Frame")
        bg.Size = UDim2.new(1, 0, 1, 0)
        bg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        bg.Parent = healthGui
        
        local fill = Instance.new("Frame")
        fill.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        fill.Size = UDim2.new(1, 0, 1, 0)
        fill.Parent = bg
        
        espObjects[plr] = {Folder = folder, Health = fill}
    else
        espObjects[plr] = {Folder = folder}
    end
end

runService.RenderStepped:Connect(function()
    if settings.ESP then
        for _, plr in ipairs(players:GetPlayers()) do
            if plr ~= player and plr.Character and not espObjects[plr] then
                createESP(plr)
            end
        end
        
        for plr, data in pairs(espObjects) do
            if not plr.Character or not plr.Character.Parent then
                data.Folder:Destroy()
                espObjects[plr] = nil
                trailObjects[plr] = nil
            else
                if settings.ShowHealth and data.Health then
                    local hum = plr.Character:FindFirstChild("Humanoid")
                    if hum then
                        local healthPercent = hum.Health / hum.MaxHealth
                        data.Health.Size = UDim2.new(healthPercent, 0, 1, 0)
                        data.Health.BackgroundColor3 = healthPercent > 0.5 and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(200, 0, 0)
                    end
                end
                
                if settings.ShowTrails and trailObjects[plr] then
                    local head = plr.Character:FindFirstChild("Head")
                    trailObjects[plr].Point1 = camera.CFrame.Position
                    trailObjects[plr].Point2 = head and head.Position or plr.Character.PrimaryPart.Position
                    trailObjects[plr].AlwaysOnTop = settings.Wallhack
                end
                
                for _, child in ipairs(data.Folder:GetChildren()) do
                    if child:IsA("Adornment") then
                        child.AlwaysOnTop = settings.Wallhack
                    end
                end
            end
        end
    else
        for _, data in pairs(espObjects) do
            data.Folder:Destroy()
        end
        espObjects = {}
        trailObjects = {}
    end
end)

