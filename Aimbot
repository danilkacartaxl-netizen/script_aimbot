local function createButton(text, yPos, tabId)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 100, 0, 30)
    btn.Position = UDim2.new(0, 15, 0, yPos)
    btn.BackgroundTransparency = 1
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(150, 150, 150)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.BorderSizePixel = 0
    btn.Parent = MainFrame
    
    local ActiveStroke = Instance.new("UIStroke")
    ActiveStroke.Color = Color3.fromRGB(139, 92, 246)
    ActiveStroke.Thickness = 2
    ActiveStroke.Transparency = 1
    ActiveStroke.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        for _, b in ipairs(MainFrame:GetChildren()) do
            if b:IsA("TextButton") and b:FindFirstChild("UIStroke") then
                b.TextColor3 = Color3.fromRGB(150, 150, 150)
                b.UIStroke.Transparency = 1
            end
        end
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        ActiveStroke.Transparency = 0
        
        local ContentFrame = MainFrame:FindFirstChild("ContentFrame")
        if ContentFrame then
            for _, child in ipairs(ContentFrame:GetChildren()) do
                if child.Name == "TabContent" then
                    child.Visible = false
                end
            end
            local TargetTab = ContentFrame:FindFirstChild(tabId)
            if TargetTab then
                TargetTab.Visible = true
            end
        end
    end)
    return btn
end

