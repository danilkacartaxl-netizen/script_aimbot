-- ===== ОПРЕДЕЛЕНИЕ КОМАНДЫ =====
local function getTeam(player)
    if not player or not player.Character then return nil end
    local name = player.Name:lower()
    if name:find("sheriff") or name:find("шериф") then
        return "Sheriff"
    elseif name:find("murderer") or name:find("убийц") or name:find("kill") then
        return "Murderer"
    end
    if player.Team then
        return player.Team.Name
    end
    local myTeam = plr.Team
    if myTeam and player.Team == myTeam then
        return "Ally"
    else
        return "Enemy"
    end
end

local function isEnemy(player)
    if player == plr then return false end
    local myTeam = getTeam(plr)
    local theirTeam = getTeam(player)
    if myTeam == "Ally" or theirTeam == "Ally" then
        return myTeam ~= theirTeam
    end
    return theirTeam ~= myTeam
end

-- ===== WALLBANG =====
local function canSee(pos1, pos2)
    if not wall then return true end
    local ray = Ray.new(pos1, pos2 - pos1)
    local part, hit = ws:FindPartOnRayWithIgnoreList(ray, {plr.Character})
    return (hit - pos1).Magnitude >= (pos2 - pos1).Magnitude - 2
end

