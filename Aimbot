-- УПРАВЛЕНИЕ МЕНЮ
-- ==============================================
local dragging = false
local dragStart, startPos

btn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = btn.Position
    end
end)

btn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

uis.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, 
                                 startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        if menu.Visible then
            local x = btn.AbsolutePosition.X
            local w = cam.ViewportSize.X
            menu.Position = UDim2.new(0, x + (x < w/2 and 42 or -190), 0, btn.AbsolutePosition.Y)
        end
    end
end)

local function toggleMenu()
    menu.Visible = not menu.Visible
    if menu.Visible then
        local x = btn.AbsolutePosition.X
        local w = cam.ViewportSize.X
        menu.Position = UDim2.new(0, x + (x < w/2 and 42 or -190), 0, btn.AbsolutePosition.Y)
    end
end

btn.MouseButton1Click:Connect(toggleMenu)
uis.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.B or input.KeyCode == Enum.KeyCode.D then
        toggleMenu()
    end
end)

