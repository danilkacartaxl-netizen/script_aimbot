-- 4. УПРАВЛЕНИЕ
-- ==============================================
local dragging = false
local dragStart, startPos

btn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = btn.Position
        uis.MouseIconEnabled = false
    end
end)

btn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
        dragging = false
        uis.MouseIconEnabled = true
    end
end)

uis.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        if menu.Visible then
            local absX = btn.AbsolutePosition.X
            if absX < cam.ViewportSize.X / 2 then
                menu.Position = UDim2.new(0, btn.AbsolutePosition.X + 40, 0, btn.AbsolutePosition.Y)
            else
                menu.Position = UDim2.new(0, btn.AbsolutePosition.X - 185, 0, btn.AbsolutePosition.Y)
            end
        end
    end
end)

local function toggleMenu()
    menu.Visible = not menu.Visible
    if menu.Visible then
        local absX = btn.AbsolutePosition.X
        if absX < cam.ViewportSize.X / 2 then
            menu.Position = UDim2.new(0, btn.AbsolutePosition.X + 40, 0, btn.AbsolutePosition.Y)
        else
            menu.Position = UDim2.new(0, btn.AbsolutePosition.X - 185, 0, btn.AbsolutePosition.Y)
        end
    end
end

btn.MouseButton1Click:Connect(toggleMenu)
uis.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.B or input.KeyCode == Enum.KeyCode.D then toggleMenu() end
end)

-- ==============================================
-- 5. ИГРОВАЯ ЛОГИКА
-- ==============================================
local function getTeam(player)
    if not player or not player.Character then return nil end
    local myTeam = plr.Team
    if myTeam and player.Team == myTeam then return "Ally"
    else return "Enemy" end
end

local function isEnemy(player)
    if player == plr then return false end
    local myTeam = getTeam(plr)
    local theirTeam = getTeam(player)
    if myTeam == "Ally" or theirTeam == "Ally" then return myTeam ~= theirTeam end
    return theirTeam ~= myTeam
end

local function canSee(pos1, pos2)
    local ray = Ray.new(pos1, pos2 - pos1)
    local part, hit = ws:FindPartOnRayWithIgnoreList(ray, {plr.Character})
    return (hit - pos1).Magnitude >= (pos2 - pos1).Magnitude - 2
end

local function shootTarget(targetPos)
    if not targetPos or not mouse then return end
    local scr = cam:WorldToViewportPoint(targetPos)
    if scr then
        mouse.Move(UDim2.new(0, scr.X, 0, scr.Y))
        mouse.Button1Down()
        task.wait(0.02)
        mouse.Button1Up()
    end
end

rs.RenderStepped:Connect(function()
    -- Fog
    if Settings.fog then
        if not fogFolder then
            fogFolder = Instance.new("Atmosphere")
            fogFolder.Name = "SWILL_Fog"
            fogFolder.Color = Color3.fromRGB(255, 255, 255)
            fogFolder.Density = Settings.fogDensity
            fogFolder.Offset = 0
            fogFolder.Parent = lighting
        else
            fogFolder.Density = Settings.fogDensity
        end
    else
        if fogFolder then
            fogFolder:Destroy()
            fogFolder = nil
        end
    end
    
    -- Spin 360
    if Settings.spin and plr.Character then
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(Settings.spinSpeed), 0)
        end
    end

    -- ESP
    if Settings.esp then
        for _, p in ipairs(players:GetPlayers()) do
            if p ~= plr and p.Character then
                if not highlights[p] then
                    local h = Instance.new("Highlight")
                    h.FillColor = isEnemy(p) and enemyColor or teamColor
                    h.FillTransparency = 0.45
                    h.OutlineColor = Color3.new(1, 1, 1)
                    h.OutlineTransparency = 0.25
                    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    h.Parent = p.Character
                    highlights[p] = h
                    p.CharacterAdded:Connect(function()
                        if highlights[p] then
                            highlights[p]:Destroy()
                            highlights[p] = nil
                        end
                    end)
                else
                    highlights[p].FillColor = isEnemy(p) and enemyColor or teamColor
                end
            end
        end
        for p, h in pairs(highlights) do
            if not p or not p.Character or not h.Parent then
                if h then h:Destroy() end
                highlights[p] = nil
            end
        end
    else
        for _, h in pairs(highlights) do
            if h then h:Destroy() end
        end
        highlights = {}
    end

    -- Aimbot + Autofire (без FOV)
    local targetPos = nil
    local targetPlayer = nil

    if (Settings.aimbot or Settings.autofire) and plr.Character then
        local camPos = cam.CFrame.Position
        local bestDist = math.huge

        for _, p in ipairs(players:GetPlayers()) do
            if p ~= plr and isEnemy(p) and p.Character then
                local head = p.Character:FindFirstChild("Head")
                if head then
                    local scr, onScreen = cam:WorldToViewportPoint(head.Position)
                    if onScreen and scr.Z > 0 then
                        local ok = true
                        if Settings.wall then ok = canSee(camPos, head.Position) end
                        if ok then
                            local dist = (camPos - head.Position).Magnitude
                            if dist < bestDist then
                                bestDist = dist
                                targetPos = head.Position
                                targetPlayer = p
                            end
                        end
                    end
                end
            end
        end
    end

    if Settings.aimbot and targetPos then
        cam.CFrame = CFrame.lookAt(cam.CFrame.Position, targetPos)
    end

    if Settings.autofire and targetPos and targetPlayer then
        shootTarget(targetPos)
    end
end)

