-- 5. НАСТРОЙКИ И ЛОГИКА ИГРЫ (АИМБОТ НА КРАСНЫХ)
-- ==============================================
local aimEnabled = false
local espEnabled = false
local fovSize = 90
local green = Color3.fromRGB(0, 255, 50)  -- Союзник
local red = Color3.fromRGB(255, 0, 0)     -- Враг (Красный)

local function getEnemyColor(player)
    -- В MVsD красный ник/часть тела = враг, синий = союзник
    if player.Name:find("Killer") or player.Name:find("Murderer") or player.Name:find("Red") then
        return red
    end
    -- Визуальная проверка по цвету (упрощенно для скрипта)
    if player.Character and player.Character:FindFirstChild("Head") then
        -- В некоторых дуэльных играх цвет обводит игрока. Здесь используем простую логику.
        return red -- По умолчанию враг красный (для теста)
    end
    return green
end

RunService.RenderStepped:Connect(function()
    -- ESP
    if espEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local head = player.Character:FindFirstChild("Head")
                if head then
                    local highlight = head:FindFirstChild("ESP_HL")
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "ESP_HL"
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        highlight.Parent = head
                    end
                    highlight.FillColor = getEnemyColor(player)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.3
                    highlight.OutlineTransparency = 0.1
                end
            end
        end
    else
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character then
                local head = player.Character:FindFirstChild("Head")
                if head and head:FindFirstChild("ESP_HL") then
                    head.ESP_HL:Destroy()
                end
            end
        end
    end

    -- Aimbot (Целится только в красных врагов)
    if aimEnabled then
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local bestTarget = nil
        local bestDist = math.huge
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local head = player.Character:FindFirstChild("Head")
                if head then
                    local scr, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen and scr.Z > 0 then
                        local dist = (Vector2.new(scr.X, scr.Y) - center).Magnitude
                        -- Целимся только если враг красный и в радиусе FOV
                        if dist <= fovSize and getEnemyColor(player) == red then
                            if dist < bestDist then
                                bestDist = dist
                                bestTarget = head
                            end
                        end
                    end
                end
            end
        end
        
        if bestTarget then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, bestTarget.Position)
        end
    end
end)

