-- Функция создания кнопок категорий
local ActiveButton = nil
local function createCategoryButton(text, icon, tabId, yPos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -16, 0, 38)
    btn.Position = UDim2.new(0, 8, 0, yPos)
    btn.BackgroundTransparency = 1
    btn.Text = "  " .. text
    btn.TextColor3 = Color3.fromRGB(60, 60, 60)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.BorderSizePixel = 0
    btn.Parent = Sidebar
    
    local IconLabel = Instance.new("TextLabel")
    IconLabel.Size = UDim2.new(0, 16, 0, 16)
    IconLabel.Position = UDim2.new(0, 0, 0.5, -8)
    IconLabel.BackgroundTransparency = 1
    IconLabel.Text = icon
    IconLabel.TextColor3 = Color3.fromRGB(60, 60, 60)
    IconLabel.Font = Enum.Font.GothamBold
    IconLabel.TextSize = 14
    IconLabel.Parent = btn
    
    local ActiveLine = Instance.new("Frame")
    ActiveLine.Size = UDim2.new(0, 2, 0.5, 0)
    ActiveLine.Position = UDim2.new(1, 0, 0.25, 0)
    ActiveLine.BackgroundColor3 = Settings.AccentColor
    ActiveLine.BorderSizePixel = 0
    ActiveLine.Visible = false
    ActiveLine.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        if ActiveButton then
            ActiveButton.TextColor3 = Color3.fromRGB(60, 60, 60)
            ActiveButton:FindFirstChild("TextLabel").TextColor3 = Color3.fromRGB(60, 60, 60)
            ActiveButton:FindFirstChild("Frame").Visible = false
        end
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        IconLabel.TextColor3 = Settings.AccentColor
        ActiveLine.Visible = true
        ActiveButton = btn
        
        -- Скрыть все вкладки и показать нужную
        for _, child in ipairs(ContentArea:GetChildren()) do
            if child:IsA("Frame") then child.Visible = false end
        end
        local targetTab = ContentArea:FindFirstChild(tabId)
        if targetTab then targetTab.Visible = true end
        CurrentTab = tabId
    end)
    return btn
end

