-- ROLE DETECTION
local function getRole(player)
    if not player or not player.Character then return "Innocent" end
    
    local name = player.Name:lower()
    if name:find("murderer") or name:find("мардер") or name:find("kill") then
        return "Murderer"
    elseif name:find("sheriff") or name:find("шериф") or name:find("detective") then
        return "Sheriff"
    end
    
    if player:FindFirstChild("Role") then
        return player.Role.Value
    end
    
    for _, child in ipairs(ws:GetChildren()) do
        if child.Name == player.Name and child:FindFirstChild("Role") then
            return child.Role.Value
        end
    end
    
    if player.Character then
        local tool = player.Character:FindFirstChildOfClass("Tool")
        if tool then
            local toolName = tool.Name:lower()
            if toolName:find("knife") or toolName:find("blade") or toolName:find("dagger") then
                return "Murderer"
            elseif toolName:find("gun") or toolName:find("pistol") or toolName:find("shoot") then
                return "Sheriff"
            end
        end
    end
    
    return "Innocent"
end

local function isEnemy(player)
    if player == plr then return false end
    local myRole = getRole(plr)
    local theirRole = getRole(player)
    
    if myRole == "Murderer" then
        return theirRole ~= "Murderer"
    end
    
    if myRole == "Sheriff" then
        return theirRole == "Murderer"
    end
    
    return theirRole == "Murderer"
end

local function getRoleColor(player)
    local role = getRole(player)
    if role == "Murderer" then
        return red
    elseif role == "Sheriff" then
        return blue
    else
        return green
    end
end

-- Toggle Buttons
local function makeToggle(name, y, def, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 170, 0, 24)
    b.Position = UDim2.new(0, 10, 0, y)
    b.BackgroundColor3 = def and Color3.new(0.3, 0.05, 0.05) or Color3.new(0.12, 0.12, 0.12)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Text = name .. " " .. (def and "ON" or "OFF")
    b.Font = Enum.Font.SourceSansBold
    b.TextSize = 13
    b.BorderSizePixel = 0
    b.Parent = menu

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = b

    b.MouseButton1Click:Connect(function()
        def = not def
        b.BackgroundColor3 = def and Color3.new(0.3, 0.05, 0.05) or Color3.new(0.12, 0.12, 0.12)
        b.Text = name .. " " .. (def and "ON" or "OFF")
        if callback then callback(def) end
    end)
    return b
end

