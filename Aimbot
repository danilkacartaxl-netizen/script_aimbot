-- Кнопки меню
local function createNavButton(text, yPos, tabId)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 35)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.BackgroundTransparency = 1
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(150, 150, 150)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.BorderSizePixel = 0
    btn.Parent = Sidebar
    
    local activeStroke = Instance.new("UIStroke")
    activeStroke.Color = Color3.fromRGB(147, 51, 234)
    activeStroke.Thickness = 2
    activeStroke.Transparency = 1
    activeStroke.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        -- Сброс активных стилей
        for _, b in ipairs(Sidebar:GetDescendants()) do
            if b:IsA("TextButton") then
                b.TextColor3 = Color3.fromRGB(150, 150, 150)
                b:FindFirstChild("UIStroke").Transparency = 1
            end
        end
        -- Активация нажатой кнопки
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        activeStroke.Transparency = 0
        
        -- Переключение вкладок
        for _, child in ipairs(ContentArea:GetChildren()) do
            if child.Name == "TabContent" then
                child.Visible = false
            end
        end
        local targetTab = ContentArea:FindFirstChild(tabId)
        if targetTab then
            targetTab.Visible = true
        end
    end)
    return btn
end

