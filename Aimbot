    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local folder = player.Character:FindFirstChild("ESP_" .. player.Name)
            if folder then
                for _, child in ipairs(folder:GetChildren()) do
                    if child:IsA("Adornment") then
                        child.ZIndex = Config.Wallhack and 10 or 0
                    end
                end
            end
        end
    end
end)

-- Обновление цвета ESP
local function UpdateESPColor()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local folder = player.Character:FindFirstChild("ESP_" .. player.Name)
            if folder then
                for _, child in ipairs(folder:GetChildren()) do
                    if child:IsA("Adornment") then
                        child.Color3 = GetCurrentColor()
                    end
                end
            end
        end
    end
end

