-- Функция получения роли игрока
local function getRole(player)
    if not player or not player.Character then return "Innocent" end
    
    local char = player.Character
    
    -- Простейшая проверка на оружие (для MM2)
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local name = tool.Name:lower()
        if name:find("knife") or name:find("blade") or name:find("dagger") or name:find("sword") then
            return "Murderer"
        elseif name:find("gun") or name:find("pistol") or name:find("revolver") or name:find("shoot") then
            return "Sheriff"
        end
    end
    
    return "Innocent"
end

-- Проверка, является ли игрок врагом
local function isEnemy(player)
    if player == plr then return false end
    local myRole = getRole(plr)
    local theirRole = getRole(player)
    
    if myRole == "Murderer" then
        return theirRole ~= "Murderer"
    elseif myRole == "Sheriff" then
        return theirRole == "Murderer"
    end
    return false
end

-- Функция NoClip (Прохождение сквозь стены)
local function updateNoclip()
    if not plr.Character then return end
    local state = settings.NoClip
    for _, part in ipairs(plr.Character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not state
        end
    end
end

-- Функция AutoKill (Убийство всех врагов разом для Убийцы)
local function runAutoKill()
    if not settings.AutoKill then return end
    if getRole(plr) ~= "Murderer" then return end
    if not plr.Character then return end
    
    local tool = plr.Character:FindFirstChildOfClass("Tool")
    if not tool then return end -- Нет ножа, не можем бить
    
    local mouse = plr:GetMouse()
    if not mouse then return end
    
    for _, p in ipairs(players:GetPlayers()) do
        if p ~= plr and isEnemy(p) and p.Character then
            local head = p.Character:FindFirstChild("Head")
            if head then
                local oldHit = mouse.Hit
                mouse.Hit = CFrame.new(head.Position + Vector3.new(0, 1, 0))
                mouse.Button1Down:Fire()
                task.wait(0.05)
                mouse.Button1Up:Fire()
                mouse.Hit = oldHit
                task.wait(0.1)
            end
        end
    end
end

-- Функция Aimbot
local function runAimbot()
    if not settings.Aimbot then return end
    if not plr.Character then return end
    
    -- Проверяем, есть ли у нас оружие
    local myRole = getRole(plr)
    if myRole == "Innocent" then return end -- Иннокент не может стрелять/бить

    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local bestTarget = nil
    local bestDist = math.huge
    
    for _, p in ipairs(players:GetPlayers()) do
        if p ~= plr and isEnemy(p) and p.Character then
            local head = p.Character:FindFirstChild("Head")
            if head then
                local scrPoint, onScreen = cam:WorldToViewportPoint(head.Position)
                if onScreen and scrPoint.Z > 0 then
                    local dist = (Vector2.new(scrPoint.X, scrPoint.Y) - center).Magnitude
                    if dist <= settings.FOV and dist < bestDist then
                        bestDist = dist
                        bestTarget = head
                    end
                end
            end
        end
    end
    
    if bestTarget then
        cam.CFrame = CFrame.lookAt(cam.CFrame.Position, bestTarget.Position)
    end
end

-- Функция Обновления ESP
local function updateESP()
    if not settings.ESP then
        -- Очищаем хайлайты если ESP выключен
        for _, h in pairs(highlights) do if h then h:Destroy() end end
        highlights = {}
        return
    end
    
    for _, p in ipairs(players:GetPlayers()) do
        if p ~= plr and p.Character then
            if not highlights[p] then
                local h = Instance.new("Highlight")
                h.FillColor = roleColors[getRole(p)] or roleColors.Innocent
                h.FillTransparency = 0.3
                h.OutlineColor = Color3.fromRGB(255, 255, 255)
                h.OutlineTransparency = 0.1
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Parent = p.Character
                highlights[p] = h
                
                -- Очистка при респавне
                p.CharacterAdded:Connect(function()
                    if highlights[p] then
                        highlights[p]:Destroy()
                        highlights[p] = nil
                    end
                end)
            else
                -- Обновляем цвет если роль сменилась
                highlights[p].FillColor = roleColors[getRole(p)] or roleColors.Innocent
            end
        end
    end
    
    -- Очистка мертвых игроков из списка
    for p, h in pairs(highlights) do
        if not p or not p.Character or not h.Parent then
            if h then h:Destroy() end
            highlights[p] = nil
        end
    end
end

-- Функция Weapon ESP
local function updateWeaponESP()
    if not settings.WeaponESP then
        for _, h in pairs(weaponHighlights) do if h then h:Destroy() end end
        weaponHighlights = {}
        return
    end
    
    -- Ищем оружие на земле
    for _, item in ipairs(ws:GetDescendants()) do
        if item:IsA("Tool") and item.Parent ~= plr.Character then
            local handle = item:FindFirstChild("Handle")
            if handle and not handle:FindFirstChild("SW_WeaponHighlight") then
                local h = Instance.new("Highlight")
                h.Name = "SW_WeaponHighlight"
                h.FillColor = Color3.fromRGB(255, 215, 0)
                h.FillTransparency = 0.2
                h.OutlineColor = Color3.fromRGB(255, 255, 255)
                h.OutlineTransparency = 0.1
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Parent = handle
                table.insert(weaponHighlights, h)
            end
        end
    end
end

