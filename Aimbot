    bLine.BackgroundColor3 = menuColors[Settings.menuColor]
    bLine.BackgroundTransparency = 1
    bLine.BorderSizePixel = 0
    bLine.Parent = b

    b.MouseButton1Click:Connect(function()
        for _, child in ipairs(menu:GetChildren()) do
            if child.Name == "TabContent" then child.Visible = false end
            if child:IsA("TextButton") and child:FindFirstChild("Frame") then
                child.TextColor3 = Color3.fromRGB(150, 150, 150)
                child.Frame.BackgroundTransparency = 1
            end
        end
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
        bLine.BackgroundTransparency = 0
        
        local cFrame = menu:FindFirstChild("ContentFrame")
        if cFrame then
            local t = cFrame:FindFirstChild(text)
            if t then t.Visible = true end
        end
    end)
    return b
end

