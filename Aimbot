local activeBtn = nil
local function createNavButton(text, yPos, tabId)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 80, 0, 26)
    btn.Position = UDim2.new(0, 15, 0, yPos)
    btn.BackgroundTransparency = 1
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(160, 160, 160)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.BorderSizePixel = 0
    btn.Parent = MainFrame
    
    btn.MouseButton1Click:Connect(function()
        if activeBtn then
            activeBtn.TextColor3 = Color3.fromRGB(160, 160, 160)
        end
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        activeBtn = btn
        
        local ContentFrame = MainFrame:FindFirstChild("Content")
        if ContentFrame then
            for _, child in ipairs(ContentFrame:GetChildren()) do
                if child.Name == "Tab" then
                    child.Visible = false
                end
            end
            local targetTab = ContentFrame:FindFirstChild(tabId)
            if targetTab then targetTab.Visible = true end
        end
    end)
    return btn
end

