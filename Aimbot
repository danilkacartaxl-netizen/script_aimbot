-- Функция создания ТУМБЛЕРА (Toggle)
local function createToggle(card, text, toggleKey)
    local cardLabel = card:FindFirstChild("Label")
    if cardLabel then
        cardLabel.Text = text
    end
    
    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.new(0, 32, 0, 18)
    toggle.Position = UDim2.new(1, -32, 0.5, -9)
    toggle.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    toggle.BackgroundTransparency = 0.2
    toggle.Text = ""
    toggle.BorderSizePixel = 0
    toggle.Parent = card
    
    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(1, 0)
    toggleCorner.Parent = toggle
    
    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 14, 0, 14)
    indicator.Position = UDim2.new(0, 2, 0.5, -7)
    indicator.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
    indicator.BorderSizePixel = 0
    indicator.Parent = toggle
    
    local indCorner = Instance.new("UICorner")
    indCorner.CornerRadius = UDim.new(1, 0)
    indCorner.Parent = indicator
    
    local isActive = Toggles[toggleKey] or false
    if isActive then
        toggle.BackgroundColor3 = Settings.AccentColor
        toggle.BackgroundTransparency = 0.3
        indicator.Position = UDim2.new(1, -16, 0.5, -7)
        indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    end
    
    toggle.MouseButton1Click:Connect(function()
        isActive = not isActive
        Toggles[toggleKey] = isActive
        if isActive then
            toggle.BackgroundColor3 = Settings.AccentColor
            toggle.BackgroundTransparency = 0.3
            indicator.Position = UDim2.new(1, -16, 0.5, -7)
            indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        else
            toggle.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            toggle.BackgroundTransparency = 0.2
            indicator.Position = UDim2.new(0, 2, 0.5, -7)
            indicator.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
        end
    end)
end

-- Функция создания ПОЛЗУНКА (Slider)
local function createSlider(card, text, settingKey, min, max, default, format)
    local cardLabel = card:FindFirstChild("Label")
    if cardLabel then
        cardLabel.Text = text
        cardLabel.Size = UDim2.new(0.5, 0, 1, 0)
    end
    
    local sliderWrapper = Instance.new("Frame")
    sliderWrapper.Size = UDim2.new(0.4, 0, 1, 0)
    sliderWrapper.Position = UDim2.new(0.55, 0, 0, 0)
    sliderWrapper.BackgroundTransparency = 1
    sliderWrapper.Parent = card
    
    local track = Instance.new("Frame")
    track.Size = UDim2.new(0.8, 0, 0, 3)
    track.Position = UDim2.new(0, 0, 0.5, -1.5)
    track.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    track.BorderSizePixel = 0
    track.Parent = sliderWrapper
    
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0.5, 0, 1, 0)
    fill.BackgroundColor3 = Settings.AccentColor
    fill.BorderSizePixel = 0
    fill.Parent = track
    
    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0.2, 0, 1, 0)
    valueLabel.Position = UDim2.new(0.8, 0, 0, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = tostring(default)
    valueLabel.TextColor3 = Color3.fromRGB(100, 100, 100)
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.TextSize = 11
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = sliderWrapper
    
    local sliderInput = Instance.new("TextBox")
    sliderInput.Size = UDim2.new(1, 0, 1, 0)
    sliderInput.BackgroundTransparency = 1
    sliderInput.Text = ""
    sliderInput.TextColor3 = Color3.fromRGB(255, 255, 255)
    sliderInput.Font = Enum.Font.GothamBold
    sliderInput.TextSize = 11
    sliderInput.ClearTextOnFocus = false
    sliderInput.Parent = sliderWrapper
    
    local thumb = Instance.new("Frame")
    thumb.Size = UDim2.new(0, 14, 0, 14)
    thumb.Position = UDim2.new(0.5, -7, 0.5, -7)
    thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    thumb.BorderSizePixel = 0
    thumb.ZIndex = 2
    thumb.Parent = track
    
    local thumbCorner = Instance.new("UICorner")
    thumbCorner.CornerRadius = UDim.new(1, 0)
    thumbCorner.Parent = thumb
    
    local thumbStroke = Instance.new("UIStroke")
    thumbStroke.Color = Settings.AccentColor
    thumbStroke.Thickness = 1.5
    thumbStroke.Parent = thumb
    
    local currentValue = default
    local function updateSlider(value)
        value = math.clamp(value, min, max)
        currentValue = value
        local percent = (value - min) / (max - min)
        fill.Size = UDim2.new(percent, 0, 1, 0)
        thumb.Position = UDim2.new(percent, -7, 0.5, -7)
        valueLabel.Text = tostring(value)
        Settings[settingKey] = value
    end
    updateSlider(default)
    
    sliderInput.FocusLost:Connect(function()
        local val = tonumber(sliderInput.Text)
        if val then
            updateSlider(val)
        else
            sliderInput.Text = ""
        end
    end)
    
    local dragging = false
    sliderInput.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)
    sliderInput.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local pos = input.Position
            local absX = track.AbsolutePosition.X
            local absSize = track.AbsoluteSize.X
            local percent = (pos.X - absX) / absSize
            percent = math.clamp(percent, 0, 1)
            local val = min + percent * (max - min)
            updateSlider(val)
        end
    end)
end

