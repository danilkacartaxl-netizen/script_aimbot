-- ESP система
local ESPObjects = {}

local function CreateESP(player)
    if not player.Character then return end
    
    local character = player.Character
    local folder = Instance.new("Folder")
    folder.Name = "ESP_" .. player.Name
    folder.Parent = character
    
    -- Бокс
    local box = Instance.new("BoxHandleAdornment")
    box.Size = Vector3.new(3, 5, 2)
    box.Adornee = character
    box.Color3 = GetCurrentColor()
    box.Transparency = 0.5
    box.ZIndex = Config.Wallhack and 10 or 0
    box.Parent = folder
    
    -- Скелет
    local parts = {
        {"Head", "Torso"},
        {"Torso", "Left Arm"},
        {"Torso", "Right Arm"},
        {"Torso", "Left Leg"},
        {"Torso", "Right Leg"}
    }
    
    for _, pair in ipairs(parts) do
        local line = Instance.new("LineHandleAdornment")
        line.Length = 2
        line.Thickness = 2
        line.Color3 = GetCurrentColor()
        line.Transparency = 0.5
        line.ZIndex = Config.Wallhack and 10 or 0
        line.Adornee = character:FindFirstChild(pair[1])
        line.Parent = folder
    end
    
    -- Health Bar
    local healthBar = Instance.new("BillboardGui")
    healthBar.Size = UDim2.new(0, 50, 0, 5)
    healthBar.Adornee = character
    healthBar.Parent = folder
    
    local healthFrame = Instance.new("Frame")
    healthFrame.Size = UDim2.new(1, 0, 1, 0)
    healthFrame.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
    healthFrame.Parent = healthBar
    
    -- Name Tag
    local nameTag = Instance.new("BillboardGui")
    nameTag.Size = UDim2.new(0, 100, 0, 20)
    nameTag.Adornee = character
    nameTag.Parent = folder
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 1, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Parent = nameTag
end

local function UpdateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if Config.ESP and player.Character then
                if not player.Character:FindFirstChild("ESP_" .. player.Name) then
                    CreateESP(player)
                end
            else
                local folder = player.Character and player.Character:FindFirstChild("ESP_" .. player.Name)
                if folder then
                    folder:Destroy()
                end
            end
        end
    end
end

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        if Config.ESP then
            CreateESP(player)
        end
    end)
end)

-- Обновление ESP
RunService.RenderStepped:Connect(UpdateESP)

-- Обновление Wallhack
