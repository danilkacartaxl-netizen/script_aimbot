-- Логика перетаскивания ползунка
local draggingSlider = false
sliderBg.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = true end
end)
sliderBg.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = false end
end)
UserInputService.InputChanged:Connect(function(i)
    if draggingSlider and i.UserInputType == Enum.UserInputType.MouseMovement then
        local x = (i.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X
        x = math.clamp(x, 0, 1)
        sliderFill.Size = UDim2.new(x, 0, 1, 0)
        sliderBall.Position = UDim2.new(x, -5, 0.5, -5)
        Settings.FOV = math.floor(x * 180) + 20
        fovLabel.Text = "FOV: " .. Settings.FOV
    end
end)

