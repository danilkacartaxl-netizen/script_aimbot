-- ===== AIMBOT (обновлённый) =====
local function getClosestPlayer()
    local closest, shortest = nil, settings.FOV
    for _, plr in ipairs(game.Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
            if settings.TeamCheck and plr.Team == player.Team then continue end
            local part = plr.Character:FindFirstChild(settings.AimPart)
            if part then
                local pos, onScreen = camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(mouse.X, mouse.Y)).Magnitude
                    if dist < shortest then
                        shortest = dist
                        closest = plr
                    end
                end
            end
        end
    end
    return closest
end

game:GetService("RunService").RenderStepped:Connect(function()
    if not settings.Aimbot then return end
    local target = getClosestPlayer()
    if target then
        local aimPart = target.Character:FindFirstChild(settings.AimPart)
        if aimPart then
            local aimPos = aimPart.Position
            local currentPos = camera.CFrame.Position
            local direction = (aimPos - currentPos).Unit
            camera.CFrame = camera.CFrame:Lerp(CFrame.new(currentPos, currentPos + direction), settings.Smooth)
        end
    end
end)

-- ===== ESP (минималистичный) =====
local espObjects = {}

local function createESP(plr)
    if espObjects[plr] or not plr.Character then return end
    local char = plr.Character
    local folder = Instance.new("Folder")
    folder.Name = "DENWEN_ESP"
    folder.Parent = char

    local box = Instance.new("BoxHandleAdornment")
    box.Size = Vector3.new(3, 5, 1)
    box.Adornee = char
    box.Color3 = settings.ESPColor
    box.Transparency = 0.2
    box.AlwaysOnTop = settings.WallHack
    box.Parent = folder

    if settings.ShowSkeleton then
        local function addLine(p1, p2)
            local line = Instance.new("LineHandleAdornment")
            line.Adornee = char
            line.Point1 = p1.Position
            line.Point2 = p2.Position
            line.Color3 = settings.ESPColor
            line.Thickness = 1.5
            line.Transparency = 0.3
            line.AlwaysOnTop = settings.WallHack
            line.Parent = folder
        end
        local head = char:FindFirstChild("Head")
        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        local la = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftUpperArm")
        local ra = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightUpperArm")
        local ll = char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftLowerLeg")
        local rl = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightLowerLeg")
        if head and torso then
            addLine(head, torso)
            if la then addLine(torso, la) end
            if ra then addLine(torso, ra) end
            if ll then addLine(torso, ll) end
            if rl then addLine(torso, rl) end
        end
    end

    if settings.ShowName then
        local nameGui = Instance.new("BillboardGui")
        nameGui.Adornee = char:FindFirstChild("Head")
        nameGui.Size = UDim2.new(0, 100, 0, 20)
        nameGui.StudsOffset = Vector3.new(0, 2.5, 0)
        nameGui.Parent = folder
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 1, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = plr.Name
        nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLabel.TextScaled = true
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.Parent = nameGui
    end

    if settings.ShowHealth then
        local healthGui = Instance.new("BillboardGui")
        healthGui.Adornee = char:FindFirstChild("Head")
        healthGui.Size = UDim2.new(0, 50, 0, 4)
        healthGui.StudsOffset = Vector3.new(0, 2, 0)
        healthGui.Parent = folder
        local bg = Instance.new("Frame")
        bg.Size = UDim2.new(1, 0, 1, 0)
        bg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        bg.Parent = healthGui
        local fill = Instance.new("Frame")
        fill.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        fill.Size = UDim2.new(1, 0, 1, 0)
        fill.Parent = bg
        espObjects[plr] = {Folder = folder, Health = fill}
    end
end

game:GetService("RunService").RenderStepped:Connect(function()
    if settings.ESP then
        for _, plr in ipairs(game.Players:GetPlayers()) do
            if plr ~= player and plr.Character and not espObjects[plr] then
                createESP(plr)
            end
        end
        for plr, data in pairs(espObjects) do
            if not plr.Character or not plr.Character.Parent then
                data.Folder:Destroy()
                espObjects[plr] = nil
            elseif settings.ShowHealth then
                local hum = plr.Character:FindFirstChild("Humanoid")
                if hum then
                    data.Health.Size = UDim2.new(hum.Health / hum.MaxHealth, 0, 1, 0)
                end
            end
        end
    else
        for _, data in pairs(espObjects) do
            data.Folder:Destroy()
        end
        espObjects = {}
    end
end)

